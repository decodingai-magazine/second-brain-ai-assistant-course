# --- Mandatory settings ---

# OpenAI API Config (starting with Lesson 2)
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_API_KEY=

# Hugging Face API Config (starting with Lesson 3)
HUGGINGFACE_ACCESS_TOKEN=

# Comet ML (starting with Lesson 4)
COMET_API_KEY=

# --- Astraflow (OpenAI-compatible, 200+ models) ---
# Global endpoint: https://api-us-ca.umodelverse.ai/v1  Sign up: https://astraflow.ucloud-global.com
# China endpoint:  https://api.modelverse.cn/v1          Sign up: https://astraflow.ucloud.cn
USE_ASTRAFLOW=False
ASTRAFLOW_API_KEY=
ASTRAFLOW_CN_API_KEY=

# --- Optional settings ---

# If you want to use the dedicated Hugging Face endpoint (starting with Lesson 4)
USE_HUGGINGFACE_DEDICATED_ENDPOINT=False # or True to route the requests to the dedicated Hugging Face endpoint
HUGGINGFACE_DEDICATED_ENDPOINT=
